# Copy to .env and fill in real values. Never commit .env.
# Frontend vars must use the VITE_ prefix. Only the anon key belongs here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only scripts (bot AI, coin distribution, feedback emails).
# Do not prefix these with VITE_ — Vite would expose them in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
