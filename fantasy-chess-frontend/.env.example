# Copy to .env and fill in real values. Never commit .env.
# Frontend vars must use the VITE_ prefix. Only the publishable key belongs here.
# Keys come from Supabase → Settings → API Keys.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Server-only scripts (bot AI, coin distribution, feedback emails).
# Do not prefix these with VITE_ — Vite would expose them in the browser bundle.
SB_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
