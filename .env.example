# Copy to .env and fill in real values. Never commit .env.

# Supabase project URL (Settings → API)
SB_URL=https://YOUR_PROJECT_REF.supabase.co

# Secret key from Settings → API Keys. Server / GitHub Actions only.
# Never put this in frontend code or VITE_ variables.
SB_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Optional: Chess.com API requires a contact in the User-Agent.
CHESSCOM_CONTACT_EMAIL=you@example.com
